# ============================================================
#  Pharus AI — Backend do Chatbot  (EXEMPLO)
#  Copie este ficheiro para `.env` e preencha os valores.
#  O `.env` real NUNCA vai para o Git (esta na .gitignore).
#  NAO coloque a chave real AQUI (este ficheiro e versionado).
# ============================================================

# Chave da API do Google Gemini (Google AI Studio).
# Gere uma em https://aistudio.google.com/app/apikey e ponha-a no .env (nao aqui).
GEMINI_API_KEY=cole-aqui-a-sua-chave-no-ficheiro-.env

# Modelo a usar. Confirme o id EXATO disponivel no seu acesso.
# Ex.: gemini-2.5-flash (recomendado) ou gemini-2.0-flash.
GEMINI_MODEL=gemini-2.5-flash

# Porta local do servidor Node
PORT=3001

# Origem autorizada (CORS). Em producao: https://pharusai.pt
# Em desenvolvimento local com Vite, use http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Caminho do ficheiro SQLite (relativo a pasta server/)
DB_PATH=./pharus-chat.db

# Limite de mensagens de historico enviadas a API (controlo de custo)
MAX_HISTORY_MESSAGES=12

# Resumo automatico: acima de SUMMARY_TRIGGER mensagens por resumir, resume as
# antigas e mantem as ultimas SUMMARY_KEEP no historico enviado a API.
SUMMARY_TRIGGER=16
SUMMARY_KEEP=8

# Cache de FAQ: dias de validade de uma resposta em cache (0 = nunca expira)
CACHE_TTL_DAYS=30

# RAG (base de conhecimento). Modelo de embeddings do Google AI Studio.
GEMINI_EMBED_MODEL=gemini-embedding-001
RAG_TOP_K=4
RAG_MIN_SCORE=0.5
